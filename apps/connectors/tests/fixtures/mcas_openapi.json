        }
    },
    "components": {
        "schemas": {
            "ChatRequest": {
                "properties": {
                    "question": {
                        "type": "string",
                        "maxLength": 500,
                        "minLength": 3,
                        "title": "Question"
                    },
                    "request_id": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Request Id"
                    }
                },
                "type": "object",
                "required": [
                    "question"
                ],
                "title": "ChatRequest"
            },
            "HTTPValidationError": {
                "properties": {
                    "detail": {
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        },
                        "type": "array",
                        "title": "Detail"
                    }
                },
                "type": "object",
                "title": "HTTPValidationError"
            },
            "OverrideRequest": {
                "properties": {
                    "request_id": {
                        "type": "string",
                        "title": "Request Id"
                    },
                    "officer": {
                        "type": "string",
                        "title": "Officer"
                    },
                    "decision": {
                        "type": "string",
                        "title": "Decision"
                    },
                    "justification": {
                        "type": "string",
                        "title": "Justification"
                    }
                },
                "type": "object",
                "required": [
                    "request_id",
                    "officer",
                    "decision",
                    "justification"
                ],
                "title": "OverrideRequest"
            },
            "ScoreRequest": {
                "properties": {
                    "request_id": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Request Id"
                    },
                    "market": {
                        "type": "string",
                        "title": "Market"
                    },
                    "amount_eur": {
                        "type": "number",
                        "exclusiveMinimum": 0.0,
                        "title": "Amount Eur"
                    },
                    "term_months": {
                        "type": "integer",
                        "title": "Term Months"
                    },
                    "age": {
                        "type": "integer",
                        "title": "Age"
                    },
                    "annual_income_eur": {
                        "type": "number",
                        "exclusiveMinimum": 0.0,
                        "title": "Annual Income Eur"
                    },
                    "employment_length_years": {
                        "type": "number",
                        "minimum": 0.0,
                        "title": "Employment Length Years"
                    },
                    "home_ownership": {
                        "type": "string",
                        "title": "Home Ownership"
                    },
                    "fico_score": {
                        "type": "number",
                        "title": "Fico Score"
                    },
                    "dti": {
                        "type": "number",
                        "maximum": 1.0,
                        "minimum": 0.0,
                        "title": "Dti"
                    },
                    "open_accounts": {
                        "type": "integer",
                        "minimum": 0.0,
                        "title": "Open Accounts"
                    },
                    "total_accounts": {
                        "type": "integer",
                        "minimum": 0.0,
                        "title": "Total Accounts"
                    },
                    "public_records": {
                        "type": "integer",
                        "minimum": 0.0,
                        "title": "Public Records"
                    },
                    "purpose": {
                        "type": "string",
                        "title": "Purpose"
                    },
                    "revolving_balance_eur": {
                        "type": "number",
                        "minimum": 0.0,
                        "title": "Revolving Balance Eur"
                    },
                    "revolving_utilisation": {
                        "type": "number",
                        "maximum": 1.0,
                        "minimum": 0.0,
                        "title": "Revolving Utilisation"
                    },
                    "mortgage_accounts": {
                        "type": "integer",
                        "minimum": 0.0,
                        "title": "Mortgage Accounts"
                    },
                    "public_record_bankruptcies": {
                        "type": "integer",
                        "minimum": 0.0,
                        "title": "Public Record Bankruptcies"
                    },
                    "months_since_first_credit_line": {
                        "type": "integer",
                        "minimum": 0.0,
                        "title": "Months Since First Credit Line"
                    }
                },
                "type": "object",
                "required": [
                    "market",
                    "amount_eur",
                    "term_months",
                    "age",
                    "annual_income_eur",
                    "employment_length_years",
                    "home_ownership",
                    "fico_score",
                    "dti",
                    "open_accounts",
                    "total_accounts",
                    "public_records",
                    "purpose",
                    "revolving_balance_eur",
                    "revolving_utilisation",
                    "mortgage_accounts",
                    "public_record_bankruptcies",
                    "months_since_first_credit_line"
                ],
                "title": "ScoreRequest",
                "description": "Ratios are ratios (dti, revolving_utilisation); the LCLD schema's percentages are\nthe adapter's problem, not the caller's."
            },
            "StateChangeRequest": {
                "properties": {
                    "reason": {
                        "type": "string",
                        "title": "Reason"
                    },
                    "actor": {
                        "type": "string",
                        "title": "Actor",
                        "default": "unknown"
                    }
                },
                "type": "object",
                "required": [
                    "reason"
                ],
                "title": "StateChangeRequest"
            },
            "ValidationError": {
                "properties": {
                    "loc": {
                        "items": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "integer"
                                }
                            ]
                        },
                        "type": "array",
                        "title": "Location"
                    },
                    "msg": {
                        "type": "string",
                        "title": "Message"
                    },
                    "type": {
                        "type": "string",
                        "title": "Error Type"
                    },
                    "input": {
                        "title": "Input"
                    },
                    "ctx": {
                        "type": "object",
                        "title": "Context"
                    }
                },
                "type": "object",
                "required": [
                    "loc",
                    "msg",
                    "type"
                ],
                "title": "ValidationError"
            }
        }
    }
}
