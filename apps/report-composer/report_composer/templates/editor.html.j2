{% extends "base.html.j2" %}
{% from "_form.html.j2" import render_form %}
{% from "_ui.html.j2" import message_region, confirm_dialog %}
{% block title %}{{ layout.name }}: {{ project.name }}{% endblock %}
{% block page_class %} wide{% endblock %}
{#- One section's row in the outline: its number (data-number, drawn by the stylesheet), its title and the
    flags Python computed (layouts.outline_flags). Clicking it, or Enter on it, opens its form in the
    inspector. -#}
{% macro outline_row(iid, block_type, title, depth=0, number="", flags=(), selected=false, draggable=false, parts=()) -%}
<li{% if iid %} data-instance-id="{{ iid }}"{% endif %} data-block-type="{{ block_type }}" data-depth="{{ depth }}" data-number="{{ number }}" tabindex="0"{% if selected %} aria-current="true"{% endif %}{% if draggable %} draggable="true"{% endif %}>
  <span class="row-title" data-title>{{ title }}</span>
  <span class="flags" data-flags>{% for f in flags %}<span class="flag flag-{{ f.name }}" data-flag="{{ f.name }}" title="{{ f.title }}">{{ f.label }}</span>{% endfor %}</span>
  {#- the tools the section prints a numbered section of each (Exported results) -#}
  <span class="row-parts" data-parts>{% for p in parts %}<span class="row-part" data-part data-number="{{ p.number }}">{{ p.title }}</span>{% endfor %}</span>
</li>
{%- endmacro %}
{#- One section's form in the inspector, keyed by the section's instance id; only the selected one is shown.
    A palette template has no id yet (none): the script gives the new section one. -#}
{% macro section_body(iid, fields, known=true, block_type="", empty_chapter=false, unwritten_hint=none, problems=(), shown=false) -%}
<div class="section-body" data-body-for="{{ iid or '' }}"{% if not shown %} hidden{% endif %}>
  {% if not known %}<p class="notice">Unknown section: {{ block_type }}. Remove it to save the layout.</p>{% endif %}
  {% if empty_chapter %}<p class="hint" data-empty-chapter>This chapter is empty.</p>{% endif %}
  {% if unwritten_hint %}<p class="hint" data-unwritten>{{ unwritten_hint }}</p>{% endif %}
  {% if known %}{{ render_form(fields, iid or "__new__") }}{% endif %}
  <p class="problems" data-problems>{% for m in problems %}{{ m }} {% endfor %}</p>
</div>
{%- endmacro %}
{% block main %}
{% set base = root ~ "/p/" ~ project.slug %}
{% set api = root ~ "/api/p/" ~ project.slug %}
<main data-api="{{ api }}" data-base="{{ base }}" data-layout="{{ layout.id }}" data-revision="{{ layout.revision }}" data-page="editor"
      data-preview-with="{{ preview_with | tojson | forceescape }}"{% if read_only %} data-read-only="true"{% endif %}>
  {{ message_region() }}
  {% if editor or (read_only and may_write) %}{{ confirm_dialog() }}{% endif %}
  <a class="rc-back" href="{{ base }}/">&larr; Report layouts</a>
  <div class="rc-header rc-header-row">
    <div>
      <p class="rc-eyebrow">{% if read_only %}Built-in layout{% elif is_new %}New layout{% else %}Report layout{% endif %}</p>
      <h1>{% if is_new %}New layout{% else %}{{ layout.name }}{% endif %}</h1>
      {% if read_only %}<p>{{ layout.description }} Built-in layouts are shared by every project and cannot be changed: download a report with it as it is, or duplicate it to adapt it.</p>{% endif %}
    </div>
    {% if read_only %}
    <div class="page-actions">
      {% if may_write %}<button type="button" data-control="duplicate" data-layout="{{ layout.id }}">Duplicate</button>{% endif %}
      <a class="btn ghost" data-control="export-structure" href="{{ api }}/builtin-layouts/{{ layout.id }}/export" download>Export</a>
    </div>
    {% endif %}
  </div>
  {#- The one toolbar: the layout's settings (editors), then the preview's version and period, Show and
      Generate and download (the same GET form and the same POST to download-report as before). -#}
  <div class="toolbar qf-section">
    {% if editor %}
    <label class="name">Name <input name="name" required maxlength="120" value="{{ layout.name }}"{% if is_new %} autofocus{% endif %}></label>
    <label>Look <select data-control="template"><option value=""{% if not template_known %} selected{% endif %}>Platform look</option>{% for x in templates %}<option value="{{ x.id }}"{% if x.id == layout.template_id %} selected{% endif %}>{{ x.name }}</option>{% endfor %}</select></label>
    <label class="inline"><input type="checkbox" name="show_index" data-control="show_index"{% if layout.show_index %} checked{% endif %}> Table of contents</label>
    <label class="inline"><input type="checkbox" name="numbering" data-control="numbering"{% if layout.numbering %} checked{% endif %}> Number the sections</label>
    {% endif %}
    {% if systems %}
    <form method="get" class="preview-with" data-control="preview-with">
      <label>Preview with <select name="system_id">{% for x in systems %}<option value="{{ x.pid }}"{% if x.pid == preview_with.system_id %} selected{% endif %}>Version {{ x.number }}{% if x.release %} ({{ x.release }}){% endif %}</option>{% endfor %}</select></label>
      <label>From <input type="date" name="period_from" value="{{ preview_with.period_from or '' }}"></label>
      <label>To <input type="date" name="period_to" value="{{ preview_with.period_to or '' }}"></label>
      <label class="inline"><input type="checkbox" name="other_versions"{% if preview_with.other_versions %} checked{% endif %}> Other versions' runs</label>
      <button type="submit" class="small ghost">Show</button>
      {% if may_write and not is_new %}
      <details class="download-menu" data-control="download-report">
        <summary class="btn small">Generate and download &#9662;</summary>
        <div class="download-choices">
          <button type="submit" class="small ghost" name="format" value="pdf" formmethod="post" formaction="{{ base }}/layouts/{{ layout.id }}/download-report">PDF</button>
          <button type="submit" class="small ghost" name="format" value="docx" formmethod="post" formaction="{{ base }}/layouts/{{ layout.id }}/download-report">Word (DOCX)</button>
        </div>
      </details>
      {% endif %}
    </form>
    {% endif %}
    <span class="spacer"></span>
    {% if editor %}
    <span class="state" data-state></span>
    <button type="button" data-control="save">{% if is_new %}Create layout{% else %}Save{% endif %}</button>
    {% if not is_new %}
    <button type="button" class="danger" data-control="delete-layout" data-confirm-action="Delete layout" data-confirm-text="Delete the layout {{ layout.name }}? Its generated reports stay, under Reports of deleted layouts.">Delete</button>
    {% endif %}
    {% endif %}
  </div>
  {% if report_error %}<p class="notice error" role="alert" data-report-error>The report was not generated: {{ report_error }}</p>{% endif %}
  {% if editor and not template_known and templates | length == 0 %}<p class="notice">Reports use the platform look until you create one of your own. <a href="{{ base }}/templates">Create a look</a> to give reports your own font, colours and logo.</p>{% endif %}
  {% if not editor and not read_only %}<p class="meta">Revision {{ layout.revision }}. You can read this layout; editors change it.</p>{% endif %}
  {% if editor %}
  {% for grp in palette %}{% for t in grp.types %}
  <template data-block-template="{{ t.type_id }}">
    {{ outline_row(none, t.type_id, t.title, draggable=true) }}
    {{ section_body(none, t.fields) }}
  </template>
  {% endfor %}{% endfor %}
  {% endif %}
  <div class="workspace{% if not editor %} no-inspector{% endif %}">
    <section class="outline qf-section" data-outline>
      <h2>Outline</h2>
      {% if editor %}
      <details class="add-menu" data-palette>
        <summary class="btn ghost small">+ Add a section</summary>
        <div class="add-menu-panel">
          <p class="qf-help">A Chapter groups the sections after it, and everything after the Appendix goes in the appendix.</p>
          <div data-control="palette" class="palette">
            {% for grp in palette %}<div class="palette-group"><h3>{{ grp.label }}</h3>
              {% for t in grp.types %}<button type="button" data-add="{{ t.type_id }}"><strong>{{ t.title }}</strong>{% if t.description %}<span class="description">{{ t.description }}</span>{% endif %}</button>{% endfor %}
            </div>{% endfor %}
          </div>
        </div>
      </details>
      {% endif %}
      <ol id="blocks">
      {% for b in blocks %}
        {{ outline_row(b.instance_id, b.block_type, b.title if b.known else "Unknown section: " ~ b.block_type,
                       b.depth, b.number, b.flags, editor and loop.first, editor, b.parts) }}
      {% endfor %}
      </ol>
      {% if editor %}<p class="hint">Click a section to edit it; drag it to move it.</p>{% endif %}
      <p class="hint" data-coverage-note>Which tests and checklists give evidence for each control objective is set
        once for the project, in step 4, AI Assessment Sandbox. Every report uses those links.</p>
      {% if layout_problems %}<p class="problems" data-layout-problems>{% for p in layout_problems %}{{ p.pointer }}: {{ p.message }} {% endfor %}</p>{% endif %}
    </section>
    {% if editor %}
    <section class="inspector qf-section" data-inspector>
      <div class="inspector-head">
        <h2 data-inspector-title>{% if blocks %}{{ blocks[0].number }} {{ blocks[0].title if blocks[0].known else "Unknown section" }}{% endif %}</h2>
        <span class="controls">
          <button type="button" data-control="move-up" title="Move up">Up</button>
          <button type="button" data-control="move-down" title="Move down">Down</button>
          <button type="button" data-control="remove" title="Remove">Remove</button>
        </span>
      </div>
      <p class="hint" data-inspector-empty{% if blocks %} hidden{% endif %}>No section yet: use + Add a section in the outline.</p>
      <div data-bodies>
      {% for b in blocks %}
        {{ section_body(b.instance_id, b.fields, b.known, b.block_type, b.empty_chapter, b.unwritten_hint, b.problems, loop.first) }}
      {% endfor %}
      </div>
    </section>
    {% endif %}
    <section class="preview qf-section">
      <p class="preview-label" data-preview-label>{% if is_new %}Preview of the new layout{% else %}Preview of revision {{ layout.revision }}{% endif %}</p>
      {% if systems %}<p class="qf-help">The version and period chosen in the toolbar are not saved in the layout.{% if may_write and not is_new %} Generate and download makes the report with them, stores it under Generated reports and downloads it.{% endif %}</p>
      {% else %}<p class="notice">{{ no_version }}</p>{% endif %}
      {% if editor %}<div class="preview-controls"><button type="button" class="small ghost" data-control="refresh-preview">Refresh preview</button>
        <label class="inline"><input type="checkbox" data-control="auto-refresh" checked> Auto-refresh</label></div>{% endif %}
      <iframe sandbox="" title="Preview"{% if not is_new %} src="{{ preview_src }}"{% endif %}></iframe>
    </section>
  </div>
  {% if not is_new %}
  <section class="reports qf-section" id="reports" style="margin-top: 20px">
    <h2>Generated reports</h2>
    <p class="statuses" data-statuses></p>
    {% if reports %}
    <table data-reports class="reports-table">
      <thead><tr><th>Created</th><th>Version</th><th>Period</th><th>Other versions</th><th>Compare with</th><th>Layout revision</th><th>Status</th><th></th></tr></thead>
      <tbody>
      {% for r in reports %}<tr>
        <td><time datetime="{{ r.created_iso }}">{{ r.created }}</time></td><td>{% if r.system_number %}Version {{ r.system_number }}{% if r.card_revision and r.card_revision > 1 %}, revision {{ r.card_revision }}{% endif %}{% endif %}</td>
        <td>{{ r.period }}</td><td>{{ r.other }}</td><td>{{ r.compare }}</td><td>{{ r.layout_revision }}</td>
        <td>{{ (r.format or "pdf") | upper }}, {{ r.status }}</td>
        <td class="actions">{% if r.status in ("done", "partial") %}{% if r.has_pdf %}<a class="btn ghost small" href="{{ api }}/reports/{{ r.id }}/pdf" download>Download PDF</a>{% else %}<span class="muted">PDF version not available{% if r.pdf_copy_error == "too_large" %} (larger than 25 MB){% elif r.pdf_copy_error == "renderer_unavailable" %} (the renderer could not make it){% endif %}.</span>{% endif %}{% if (r.format or "pdf") == "docx" %} <a class="btn ghost small" href="{{ api }}/reports/{{ r.id }}/download" download>Download Word</a>{% endif %}{% if r.sha256 %} <span class="muted">SHA-256 {{ r.sha256[:12] }}{% if r.fingerprint %}, fingerprint {{ r.fingerprint[:12] }}{% endif %}</span>{% endif %}{% elif r.status == "interrupted" %}<span class="muted">Cut off before it finished (the composer restarted or stopped): generate it again.</span>{% endif %}</td>
      </tr>{% endfor %}
      </tbody>
    </table>
    {% else %}<p class="muted" data-reports>No report generated yet.{% if may_write %} Use Generate and download in the toolbar.{% endif %}</p>{% endif %}
  </section>
  {% endif %}
</main>
{% endblock %}
{% block script %}<script src="{{ root }}{{ asset("composer.js") }}" defer></script>{% endblock %}
