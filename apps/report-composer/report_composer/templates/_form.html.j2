{#- A block's configure form, drawn from what forms.form_fields returns (Python decides every field).
    `key` makes radio groups unique per block; a palette block uses "__new__", which the script
    replaces with the new block's id. -#}
{%- set LIGHT_HELP = "Light formatting: **bold**, *italic*, lists with - or 1., links [text](https://...), tables with |." -%}
{%- macro option_value(v) -%}{{ v if v is not none else "" }}{%- endmacro -%}
{%- macro choice_value(v) -%}{% if v is mapping %}{{ v | tojson }}{% else %}{{ v }}{% endif %}{%- endmacro -%}
{%- macro help(f) -%}{% if f.help %}<span class="help">{{ f.help }}</span>{% endif %}{%- endmacro -%}
{%- macro field(f, key) -%}
<div class="field" data-field="{{ f.name }}"{% if f.show_if %} data-show-if='{{ f.show_if | tojson }}'{% endif %}{% if f.hidden %} hidden{% endif %}>
  {% if f.widget == "all-or-list" %}
  {%- set listed = f.value is iterable and f.value is not string and f.value is not mapping -%}
  <fieldset data-option="{{ f.name }}" data-kind="all-or-list">
    <legend>{{ f.label }}{% if f.required %} *{% endif %}</legend>
    <label class="inline"><input type="radio" name="{{ key }}-{{ f.name }}" value="all" data-choice="all"{% if not listed %} checked{% endif %}> All (also ones added later)</label>
    <label class="inline"><input type="radio" name="{{ key }}-{{ f.name }}" value="list" data-choice="list"{% if listed %} checked{% endif %}> Only these:</label>
    {% if f.filter %}<input type="search" class="choice-filter" data-filter placeholder="Filter the list">{% endif %}
    <div class="choices">
    {% for o in f.options %}<label class="inline"><input type="checkbox" value="{{ choice_value(o.value) }}"{% if o.value is mapping %} data-json{% endif %}{% if listed and o.value in f.value %} checked{% endif %}> {{ o.label }}</label>
    {% endfor %}</div>
    {{ help(f) }}
  </fieldset>
  {% elif f.widget == "checkboxes" %}
  <fieldset data-option="{{ f.name }}" data-kind="list">
    <legend>{{ f.label }}{% if f.required %} *{% endif %}</legend>
    <div class="choices">
    {% for o in f.options %}<label class="inline"><input type="checkbox" value="{{ o.value }}"{% if f.value is iterable and f.value is not string and o.value in f.value %} checked{% endif %}> {{ o.label }}</label>
    {% endfor %}</div>
    {{ help(f) }}
  </fieldset>
  {% else %}
  <label>{{ f.label }}{% if f.required %} *{% endif %}
  {% if f.widget == "checkbox" %}
    <input type="checkbox" data-option="{{ f.name }}" data-kind="bool"{% if f.value %} checked{% endif %}>
  {% elif f.widget == "number" %}
    <input type="number" data-option="{{ f.name }}" data-kind="int" value="{{ option_value(f.value) }}"{% if f.min is not none %} min="{{ f.min }}"{% endif %}{% if f.max is not none %} max="{{ f.max }}"{% endif %}>
  {% elif f.widget == "select" %}
    <select data-option="{{ f.name }}" data-kind="{{ f.kind }}">
      {% if not f.required and f.kind not in ("enum", "int-or-null") %}<option value=""></option>{% endif %}
      {% for o in f.options %}<option value="{{ choice_value(o.value) }}"{% if o.value == f.value or (o.value == "" and f.value is none and f.kind == "int-or-null") %} selected{% endif %}>{{ o.label }}</option>{% endfor %}
    </select>
  {% elif f.widget == "textarea" %}
    <textarea data-option="{{ f.name }}" data-kind="str" rows="6">{{ option_value(f.value) }}</textarea>
  {% elif f.widget == "list" %}
    <input data-option="{{ f.name }}" data-kind="list" value="{{ (f.value or []) | join(', ') }}">
  {% else %}
    <input data-option="{{ f.name }}" data-kind="str" value="{{ option_value(f.value) }}">
  {% endif %}
  </label>
  {{ help(f) }}
  {% if f.light %}<span class="help">{{ LIGHT_HELP }}</span>{% endif %}
  {% endif %}
</div>
{%- endmacro -%}
{%- macro render_form(fields, key="__new__") -%}
{% for f in fields if not f.more and f.widget != "commentary" %}{{ field(f, key) }}
{% endfor %}
{% for f in fields if f.widget == "commentary" %}
<details data-commentary{% if f.value %} open{% endif %}><summary>Add a commentary</summary>
  <label>{{ f.label }} <textarea data-option="commentary" data-kind="str" rows="6">{{ option_value(f.value) }}</textarea></label>
  {{ help(f) }}
  <span class="help">{{ LIGHT_HELP }}</span>
</details>
{% endfor %}
{% set more = fields | selectattr("more") | list %}
{% if more %}
<details data-more><summary>More options</summary>
{% for f in more %}{{ field(f, key) }}
{% endfor %}
</details>
{% endif %}
{%- endmacro -%}
