{
  "format": "aisc-report-preset",
  "version": 2,
  "id": "technical-dossier",
  "name": "Technical dossier",
  "description": "Everything, for auditors and engineers: every objective with its quotes, every answer, every run of every status, and what did not change.",
  "show_index": true,
  "numbering": true,
  "blocks": [
    {
      "block_type": "cover",
      "options": {}
    },
    {
      "block_type": "free_text",
      "options": {
        "title": "Scope",
        "text": "Write this section.",
        "format": "markdown"
      }
    },
    {
      "block_type": "key_figures",
      "options": {
        "show_tool_headlines": true
      }
    },
    {
      "block_type": "chapter",
      "options": {
        "title": "The AI system"
      }
    },
    {
      "block_type": "ai_card",
      "options": {
        "show_components": true,
        "show_tags": true
      }
    },
    {
      "block_type": "risk_classification",
      "options": {
        "show_chains": true,
        "show_impact_areas": true
      }
    },
    {
      "block_type": "chapter",
      "options": {
        "title": "Control objectives"
      }
    },
    {
      "block_type": "control_objectives",
      "options": {
        "group_by": "risk",
        "show_quotes": true,
        "show_rationale": true,
        "show_severity": true,
        "include_unrated": true
      }
    },
    {
      "block_type": "control_answers",
      "options": {
        "show_scores": true,
        "show_unanswered": true,
        "include_archived": true
      }
    },
    {
      "block_type": "summary_coverage",
      "options": {}
    },
    {
      "block_type": "chart",
      "options": {
        "dataset": "coverage_status"
      }
    },
    {
      "block_type": "chapter",
      "options": {
        "title": "Evidence"
      }
    },
    {
      "block_type": "test_runs",
      "options": {
        "detail": "full"
      }
    },
    {
      "block_type": "test_results",
      "options": {
        "detail": "full",
        "statuses": [
          "Done",
          "Failed",
          "Archived",
          "Pending",
          "Processing",
          "Custom"
        ]
      }
    },
    {
      "block_type": "chart",
      "options": {
        "dataset": "checklist_scores"
      }
    },
    {
      "block_type": "changes_since",
      "options": {
        "compare_to": "previous",
        "show_unchanged": true
      }
    },
    {
      "block_type": "free_text",
      "options": {
        "title": "Findings",
        "text": "Write this section.",
        "format": "markdown"
      }
    },
    {
      "block_type": "appendix",
      "options": {}
    },
    {
      "block_type": "free_text",
      "options": {
        "title": "Method",
        "text": "Write this section.",
        "format": "markdown"
      }
    },
    {
      "block_type": "ai_card",
      "options": {
        "title": "Knowledge graph",
        "show_graph_stats": true,
        "show_components": false,
        "show_tags": false
      }
    }
  ]
}
