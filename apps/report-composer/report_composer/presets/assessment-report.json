{
  "format": "aisc-report-preset",
  "version": 2,
  "id": "assessment-report",
  "name": "Assessment report",
  "description": "What was assessed and what came out: the system, the control objectives and the tests, in chapters.",
  "show_index": true,
  "numbering": true,
  "blocks": [
    {
      "block_type": "cover",
      "options": {}
    },
    {
      "block_type": "key_figures",
      "options": {}
    },
    {
      "block_type": "chapter",
      "options": {
        "title": "The AI system"
      }
    },
    {
      "block_type": "ai_card",
      "options": {
        "show_components": true
      }
    },
    {
      "block_type": "risk_classification",
      "options": {
        "show_chains": true
      }
    },
    {
      "block_type": "chapter",
      "options": {
        "title": "Control objectives"
      }
    },
    {
      "block_type": "control_objectives",
      "options": {
        "group_by": "objective",
        "show_status": true,
        "show_severity": true
      }
    },
    {
      "block_type": "summary_coverage",
      "options": {
        "show_uncovered_only": false
      }
    },
    {
      "block_type": "chapter",
      "options": {
        "title": "Tests"
      }
    },
    {
      "block_type": "test_runs",
      "options": {
        "detail": "summary"
      }
    },
    {
      "block_type": "test_results",
      "options": {
        "detail": "summary"
      }
    },
    {
      "block_type": "changes_since",
      "options": {
        "compare_to": "previous"
      }
    }
  ]
}
