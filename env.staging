# Minio/S3 storage location config
S3_USER=s3-user
S3_PASSWORD=
S3_DATASETS_BUCKET=datasets
S3_MODELS_BUCKET=models
S3_ARTIFACTS_BUCKET=artifacts
S3_URL=http://minio:9000

# Backend config
API_URL_EXTERNAL="https://aisctest.uni.lux"
SHOW_PLUGIN_VISUALIZATION=false

# Rabbitmq config
RABBITMQ_USERNAME=rabbit-user
RABBITMQ_PASSWORD=
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# Aliasing rabbitmq config TODO: clean-up if not needed
MQ_USERNAME=$RABBITMQ_USERNAME
MQ_PASSWORD=$RABBITMQ_PASSWORD
MQ_HOST=$RABBITMQ_HOST
MQ_PORT=$RABBITMQ_PORT
MQ_USE_SSL=false

# DB configuration
POSTGRES_USER=postgres-user
POSTGRES_PASSWORD=
# One database for the whole platform: every module owns a schema in it.
POSTGRES_DB=platform
POSTGRES_DB_HOST=postgres
POSTGRES_DB_PORT=5432

# Redis configuration
REDIS_HOST=redis
REDIS_USERNAME=redis-user
REDIS_PASSWORD=
REDIS_USE_SSL=false
REDIS_PORT=6379

# Eval configuration
CELERY_BROKER_URL=amqp://$RABBITMQ_USERNAME:$RABBITMQ_PASSWORD@$RABBITMQ_HOST:$RABBITMQ_PORT//
REDIS_BACKEND_URL=redis://$REDIS_HOST:$REDIS_PORT/0
API_URL=http://aisc-backend:8000
API_PREFIX=/api/v1/internal
# INTERNAL_API_KEY comes from env.secrets, written by scripts/secrets.sh and never committed
CACHE_DIR=/tmp/cache
CORS_ORIGINS=*

# The execution engine's database. There is one database for the whole
# platform and the engine owns the `engine` schema in it, which is what
# DB_SCHEMA puts on its search path (followed by `core`, which it reads and
# never writes). It connects as its own role.
DB_NAME=platform
DB_USER=engine_rw
DB_PASSWORD=engine_rw
DB_SCHEMA=engine
DB_HOST=$POSTGRES_DB_HOST
DB_PORT=$POSTGRES_DB_PORT

# backend
APP_NAME=aisc-backend
# DJANGO_SECRET_KEY comes from env.secrets, written by scripts/secrets.sh and never committed
DB_ENGINE=django.db.backends.postgresql
DEBUG=False
LOG_LEVEL=INFO
CORS_ALLOW_ALL_ORIGINS=True
BACKEND_CORS_ALLOWED_ORIGINS="https://aisctest.uni.lux"
BACKEND_CSRF_TRUSTED_ORIGINS="https://aisctest.uni.lux"

# --- Keycloak (SSO) ---
# Admin console bootstrap user. PASSWORD left blank on purpose -> supplied by the server env.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
# Public URL the BROWSER uses to reach Keycloak (behind Caddy). Needs a DNS record + a Caddy
# route to the `keycloak` service. (A path like https://aisctest.uni.lux/auth also works if you
# also set KC_HTTP_RELATIVE_PATH=/auth on the keycloak service.)
KEYCLOAK_URL_EXTERNAL=https://auth.aisctest.uni.lux
# Backend token validation. ISSUER must match the EXTERNAL url (that's what the token carries);
# JWKS is fetched over the INTERNAL network (no TLS/Caddy hop needed — same realm keys).
AUTH_ENABLED=true
KEYCLOAK_ISSUER=https://auth.aisctest.uni.lux/realms/aisc
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/aisc/protocol/openid-connect/certs

PLUGIN_PATH=/path/to/your/plugins