+++ b/tests/test_plugin_environment.py
@@ -0,0 +1,27 @@
+"""The plugin must not inherit the worker's service-level credentials (ADR 0003)."""
+
+from aisc_eval.celery_tasks import plugin_child_env
+
+
+def test_plugin_child_env_is_closed(monkeypatch):
+    for name in (
+        "DJANGO_SECRET_KEY", "INTERNAL_API_KEY", "PACKAGE_REGISTRY_PASSWORD",
+        "DATABASE_URL", "REDIS_URL", "KEYCLOAK_CLIENT_SECRET", "AISC_UNKNOWN",
+    ):
+        monkeypatch.setenv(name, f"worker-only-{name}")
+    monkeypatch.setenv("PATH", "/usr/bin")
+    monkeypatch.setenv("LANG", "C.UTF-8")
+
+    child = plugin_child_env()
+
+    assert child["PATH"] == "/usr/bin"
+    assert child["LANG"] == "C.UTF-8"
+    assert not any(name in child for name in (
+        "DJANGO_SECRET_KEY", "INTERNAL_API_KEY", "PACKAGE_REGISTRY_PASSWORD",
+        "DATABASE_URL", "REDIS_URL", "KEYCLOAK_CLIENT_SECRET", "AISC_UNKNOWN",
+    ))
+
+
+def test_plugin_child_env_does_not_wildcard_run_secrets(monkeypatch):
+    monkeypatch.setenv("AISC_SECRET_NOT_SELECTED_FOR_THIS_RUN", "not-this-run")
+    assert "AISC_SECRET_NOT_SELECTED_FOR_THIS_RUN" not in plugin_child_env()
