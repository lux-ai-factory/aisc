(tls-development) {
  tls internal
}

(tls-staging) {
  tls /etc/caddy/aisctest.uni.lux.cert /etc/caddy/aisctest.uni.lux.key
}


# forward_auth against oauth2-proxy: one sign-in covers every module below.
# 2xx lets the request through, 401 becomes a redirect to Keycloak.
(protect) {
  forward_auth host.docker.internal:4180 {
    uri /oauth2/auth
    # Who the gateway says this is, and the token it holds for them: a page
    # behind this needs no session of its own.
    copy_headers X-Auth-Request-User X-Auth-Request-Email X-Auth-Request-Preferred-Username
    copy_headers X-Auth-Request-Access-Token
    @unauth status 401
    handle_response @unauth {
      redir * /oauth2/start?rd={http.request.uri}
    }
  }
}

# After protect: the platform says whether the caller holds the admin role. 204 lets the request
# through; its 403 goes back to the browser as it is. It reads the token protect just copied in.
(admin_only) {
  forward_auth platform:8000 {
    uri /authz/admin
  }
}

# The database diagrams: the platform reads the path Caddy passes (X-Forwarded-Uri) and lets a
# member through to the landing page, the shared platform and their own project's database.
(schema_gate) {
  forward_auth platform:8000 {
    uri /authz/schema
  }
}

# oauth2-proxy's own endpoints stay open on every origin, or there is no way in.
(oauth_endpoints) {
  handle /oauth2/* {
    reverse_proxy host.docker.internal:4180 {
      # {host} drops the port, which makes oauth2-proxy build
      # redirect_uri=http://localhost/oauth2/callback for the launcher too and
      # Keycloak answer 400. {http.request.hostport} keeps it.
      header_up Host {http.request.hostport}
      header_up X-Forwarded-Host {http.request.hostport}
      header_up X-Forwarded-Proto http
      header_up X-Real-IP {remote_host}
    }
  }
}

{$CADDY_DOMAIN}:{$CADDY_PORT} {
  log {
    format console
    output file {$LOG_FILE} {
      roll_size 10MB
      roll_keep 10
    }
  }

  import tls-{$CADDY_ENVIRONMENT}
  import oauth_endpoints


  # Internal API should only be accessible inside the containers, block all external access
  handle /api/v1/internal/* {
    respond "Forbidden - Internal Service Only" 403
  }

  # Should be the backend API, so forward also this path there
  handle /api/* {
    import protect
    reverse_proxy aisc-backend:8000 {
        header_up X-Real-IP {remote_host}
      }
  }

  # Flower 
  handle /flower/* {
    import protect
    reverse_proxy aisc-eval-flower:5555 {
        header_up X-Real-IP {remote_host}
      }
  }

  # AI-compliance checklists app (apps/controls), served under /controls
  handle /controls* {
    import protect
    reverse_proxy controls-web:3000 {
      header_up X-Real-IP {remote_host}
    }
  }

  # EU-AI-Act qualification app (apps/qualification), served under /qualification
  handle /qualification* {
    import protect
    reverse_proxy qualification-web:3000 {
      header_up X-Real-IP {remote_host}
    }
  }
  # AI Act control objectives (apps/control-objectives). handle_path strips the
  # prefix: the FastAPI app serves at /api/* and CONTROL_OBJECTIVES_ROOT_PATH only
  # fixes the URLs it generates, so the backend's own /api/* does not collide.
  handle_path /control-objectives* {
    import protect
    reverse_proxy control-objectives:8090 {
      header_up X-Real-IP {remote_host}
    }
  }

  # The report composer (apps/report-composer), step 7. handle_path strips the prefix;
  # REPORT_COMPOSER_ROOT_PATH fixes the URLs the app generates. The renderer is never routed.
  handle_path /report-composer* {
    import protect
    reverse_proxy report-composer:8095 {
      header_up X-Real-IP {remote_host}
    }
  }

  # Serve the JS frontend by default
  handle {
    import protect
    reverse_proxy aisc-webapp:80 {
      header_up X-Real-IP {remote_host}
    }
  }
}

# The launcher: one page listing the assessment modules. It has a listener of
# its own because the execution engine owns the root of the site above and
# cannot be served under a path prefix.
{$CADDY_DOMAIN}:{$HOMEPAGE_PORT} {
  import tls-{$CADDY_ENVIRONMENT}
  import oauth_endpoints
  # `route` to keep the order explicit: the API before the static files.
  route {
    # The platform's internal route (service token, resolved keys) is never served here.
    handle /api/internal/* {
      respond 404
    }
    # The platform's projects, on the launcher's own origin so the page can read
    # them with the session cookie it already has.
    handle_path /api/* {
      import protect
      reverse_proxy platform:8000
    }
    # A project's page: one file, the slug read from the URL by the page itself.
    # An explicit rewrite rather than try_files, which resolved "/" to the
    # project page because "/" is a directory.
    handle /p/* {
      import protect
      root * /srv/homepage
      rewrite * /project.html
      file_server
    }
    # pgAdmin, for admins only: it shows every project's data. It serves under this
    # prefix itself (SCRIPT_NAME), so the path goes through unstripped.
    handle /inspect/pgadmin* {
      import protect
      import admin_only
      reverse_proxy pgadmin:80
    }
    # The diagrams show structure, never rows: members see their own project's and the
    # shared platform's, and the platform decides which (see schema_gate).
    handle_path /inspect/schema* {
      import protect
      import schema_gate
      reverse_proxy schema-docs:8080
    }
    # protect goes INSIDE handle: at site level it would also guard /oauth2/*,
    # and /oauth2/start would redirect to itself for ever.
    handle {
      import protect
      root * /srv/homepage
      file_server
    }
  }
}

# The dashboard (apps/results-dashboard, Superset). Its own listener, because Superset needs the
# site root. Behind the gateway like every module: Superset has no login of its own and takes who
# is signed in from the token protect copies in (dashboard-gateway/). It runs host-networked, so
# it is reached on the Docker host address.
{$CADDY_DOMAIN}:{$DASHBOARD_PORT} {
  import tls-{$CADDY_ENVIRONMENT}
  import oauth_endpoints
  handle {
    import protect
    reverse_proxy {$DASHBOARD_UPSTREAM}
  }
}

