/.idea/
def_plugins/
env.secrets
keycloak/aisc-realm.local.json
env.runtime
env.local
env.engine-standalone

# Python bytecode
__pycache__/
*.pyc
# immudb's signing key and its public half (scripts/secrets.sh)
immudb-signing.key
immudb-signing.pub

# the Configurator's settings, Postgres's key and certificate (start --configurator) and Caddy's certificate
env.configurator
/postgres-tls/
/caddy-tls/

# adapter plugins are the operator's own (adapters/README.md): only the README is AISC's
adapters/*
!adapters/README.md

# plugins of the operator's own (local_plugins/README.md): only the README is AISC's
local_plugins/*
!local_plugins/README.md

# the documentation PDF and what goes into it (scripts/docs_pdf.py)
/build/
