/.idea/
def_plugins/

# Local, machine-specific configuration created from env.example (may contain secrets)
.env
# Runtime secrets generated by the start tooling (env.secrets says "Not in git").
env.local
env.runtime
env.secrets
immudb-signing.key
immudb-signing.pub

# Generated Playwright e2e artifacts (the test sources in e2e/ ARE tracked)
/e2e/node_modules/
/e2e/.env.e2e
/e2e/playwright-report/
/e2e/test-results/

# Python bytecode and pytest caches (the guards run from a throwaway env)
__pycache__/
*.pyc
.pytest_cache/
