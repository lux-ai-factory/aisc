# Minio/S3 storage location config
#
S3_USER=s3-user
S3_PASSWORD=dev-password
S3_DATASETS_BUCKET=datasets
S3_MODELS_BUCKET=models
S3_ARTIFACTS_BUCKET=artifacts
S3_URL=http://minio:9000

# Backend config
API_URL_EXTERNAL="http://localhost:8080"

# Keycloak URL the BROWSER uses (injected into the built webapp via env.sh -> APP_KEYCLOAK_URL).
KEYCLOAK_URL_EXTERNAL=http://localhost:8080/auth
KEYCLOAK_ISSUER=http://localhost:8080/auth/realms/aisc
KEYCLOAK_JWKS_URL=http://keycloak:8080/auth/realms/aisc/protocol/openid-connect/certs

# Public plugin catalogue URL the BROWSER opens (injected via env.sh -> APP_CATALOG_URL).
CATALOG_URL="http://localhost:8001"

CADDY_DOMAIN="http://localhost"
CADDY_ENVIRONMENT="development"
CADDY_HOST_PORT=8080
SHOW_PLUGIN_VISUALIZATION=true

# Rabbitmq config
RABBITMQ_USERNAME=rabbit-user
RABBITMQ_PASSWORD=dev-password
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# Aliasing rabbitmq config TODO: clean-up if not needed
MQ_USERNAME=$RABBITMQ_USERNAME
MQ_PASSWORD=$RABBITMQ_PASSWORD
MQ_HOST=$RABBITMQ_HOST
MQ_PORT=$RABBITMQ_PORT
MQ_USE_SSL=false

# DB configuration
POSTGRES_USER=aisc-postgres-user
POSTGRES_PASSWORD=aisc-postgres-password
POSTGRES_DB=aisc
POSTGRES_DB_HOST=postgres
POSTGRES_DB_PORT=5432

# Keycloak admin console bootstrap user (DEV ONLY — change for staging/prod)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# immudb admin password (DEV ONLY — change for staging/prod). immudb enforces a strong password.
IMMUDB_ADMIN_PASSWORD=immudbDev1!

# Redis configuration
REDIS_HOST=redis
REDIS_USERNAME=aisc-redis-user
REDIS_PASSWORD=dev-password
REDIS_USE_SSL=false
REDIS_PORT=6379

# Eval configuration
CELERY_BROKER_URL=amqp://$RABBITMQ_USERNAME:$RABBITMQ_PASSWORD@$RABBITMQ_HOST:$RABBITMQ_PORT//
REDIS_BACKEND_URL=redis://$REDIS_HOST:$REDIS_PORT/0
API_URL=http://aisc-backend:8000
API_PREFIX=/api/v1/internal
INTERNAL_API_KEY=secret_random_string_replace_me_in_production
CACHE_DIR=/tmp/cache
CORS_ORIGINS=*

# Show Tasks tab (Celery) in webapp, default false
SHOW_CELERY_TASKS=true

# Aliasing Postgres config TODO: clean-up if not needed
DB_NAME=$POSTGRES_DB
DB_USER=$POSTGRES_USER
DB_PASSWORD=$POSTGRES_PASSWORD
DB_HOST=$POSTGRES_DB_HOST
DB_PORT=$POSTGRES_DB_PORT

# backend
APP_NAME=aisc-backend
DJANGO_SECRET_KEY=your_secret_key
DB_ENGINE=django.db.backends.postgresql
DEBUG=False
LOG_LEVEL=INFO
CORS_ALLOW_ALL_ORIGINS=True
BACKEND_CORS_ALLOWED_ORIGINS="http://localhost,http://127.0.0.1"
BACKEND_CSRF_TRUSTED_ORIGINS="http://localhost,http://127.0.0.1"

PLUGIN_PATH=/path/to/your/plugins

PACKAGE_REGISTRY_URL=http://localhost:3141/
PACKAGE_REGISTRY_USER=
PACKAGE_REGISTRY_PASSWORD=
PACKAGE_REGISTRY_INDEX=root/public

# Results and the analytics dashboard (ANA-01). The dashboard is the pilot's own
# Superset process, deployed separately; nothing here reads it, these only say
# where it is and how to authenticate.
#
# With RESULTS_DASHBOARD_URL *and* RESULTS_DASHBOARD_SECRET set, the results page
# links to the dashboard, signed and scoped (the key must be the same on the
# dashboard side). With either missing there is no link at all: a link the
# dashboard cannot verify is not a link.
RESULTS_DASHBOARD_URL=
RESULTS_DASHBOARD_SECRET=
RESULTS_DASHBOARD_LINK_TTL=900
# The dashboard's own bridge API (`POST /api/v1/aisc_project/<pid>`), used by
# "Publish to the dashboard" on the results page. Empty URL or token: the call is
# not made at all (the dashboard refuses a call with an empty token anyway).
RESULTS_DASHBOARD_BRIDGE_URL=
RESULTS_DASHBOARD_BRIDGE_TOKEN=
# The dashboard's own Redis (compose profile `analytics`). It must ask for a
# password and is never shared with the eval cache: `docker compose --profile
# analytics up -d` refuses to start without this. See docs/ops/results-dashboard.md.
DASHBOARD_REDIS_PASSWORD=

AUTH_ENABLED=true
MODEL_LISTING_SSL_VERIFY=false
