# =============================================================================
# AISC — configuration template for the published-image Docker Compose stack.
#
# Quick start:
#   cp env.example .env
#   docker compose up -d
#
# Docker Compose reads `.env` automatically when you run `docker compose` from
# this directory, so no --env-file flag is required. Edit the values below before
# exposing this stack beyond your machine (passwords, keys, secret key, ...).
# =============================================================================

# Image tag pulled from ghcr.io/lux-ai-factory/*. Use `latest` for the newest
# published release, or pin a version (e.g. v1.3.0) for a reproducible stack.
AISC_IMAGE_TAG=latest

# -----------------------------------------------------------------------------
# Public entrypoint (Caddy reverse proxy)
# -----------------------------------------------------------------------------
# Everything is served through Caddy on this host port. Open http://localhost:<port>
CADDY_HOST_PORT=8080
CADDY_DOMAIN=http://localhost
CADDY_ENVIRONMENT=development
API_URL_EXTERNAL=http://localhost:8080

# Browser-facing Keycloak (single sign-on) URL.
KEYCLOAK_URL_EXTERNAL=http://localhost:8080/auth
KEYCLOAK_ISSUER=http://localhost:8080/auth/realms/aisc
KEYCLOAK_JWKS_URL=http://keycloak:8080/auth/realms/aisc/protocol/openid-connect/certs
AUTH_ENABLED=true
# Keycloak admin console bootstrap user (change before exposing the stack).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Public plugin catalogue URL the browser opens. The catalogue will eventually
# replace the bundled plugin-downloader service.
CATALOG_URL=http://localhost:8001

# -----------------------------------------------------------------------------
# Plugins
# -----------------------------------------------------------------------------
# Inside the stack the plugins live on a shared Docker volume, populated by the
# `plugin-downloader` service (default plugins) — leave this as-is.
PLUGIN_PATH=/app/plugins

# -----------------------------------------------------------------------------
# Object storage (MinIO) — any S3-compatible endpoint works
# -----------------------------------------------------------------------------
S3_USER=s3-user
S3_PASSWORD=dev-password
S3_DATASETS_BUCKET=datasets
S3_MODELS_BUCKET=models
S3_ARTIFACTS_BUCKET=artifacts
S3_URL=http://minio:9000
MODEL_LISTING_SSL_VERIFY=false

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=aisc-postgres-user
POSTGRES_PASSWORD=aisc-postgres-password
POSTGRES_DB=aisc
POSTGRES_DB_HOST=postgres
POSTGRES_DB_PORT=5432

# Aliases kept for the backend's DB_* variables.
DB_NAME=$POSTGRES_DB
DB_USER=$POSTGRES_USER
DB_PASSWORD=$POSTGRES_PASSWORD
DB_HOST=$POSTGRES_DB_HOST
DB_PORT=$POSTGRES_DB_PORT
DB_ENGINE=django.db.backends.postgresql

# -----------------------------------------------------------------------------
# RabbitMQ (Celery broker) + Redis (results)
# -----------------------------------------------------------------------------
RABBITMQ_USERNAME=rabbit-user
RABBITMQ_PASSWORD=dev-password
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

MQ_USERNAME=$RABBITMQ_USERNAME
MQ_PASSWORD=$RABBITMQ_PASSWORD
MQ_HOST=$RABBITMQ_HOST
MQ_PORT=$RABBITMQ_PORT
MQ_USE_SSL=false

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=aisc-redis-user
REDIS_PASSWORD=dev-password
REDIS_USE_SSL=false

CELERY_BROKER_URL=amqp://$RABBITMQ_USERNAME:$RABBITMQ_PASSWORD@$RABBITMQ_HOST:$RABBITMQ_PORT//
REDIS_BACKEND_URL=redis://$REDIS_HOST:$REDIS_PORT/0

# -----------------------------------------------------------------------------
# Backend (Django) / evaluation service
# -----------------------------------------------------------------------------
APP_NAME=aisc-backend
DJANGO_SECRET_KEY=your_secret_key_replace_me_in_production
DEBUG=False
LOG_LEVEL=INFO
CORS_ALLOW_ALL_ORIGINS=True
BACKEND_CORS_ALLOWED_ORIGINS="http://localhost,http://127.0.0.1"
BACKEND_CSRF_TRUSTED_ORIGINS="http://localhost,http://127.0.0.1"

API_URL=http://aisc-backend:8000
API_PREFIX=/api/v1/internal
INTERNAL_API_KEY=secret_random_string_replace_me_in_production
CACHE_DIR=/tmp/cache
CORS_ORIGINS=*
SHOW_PLUGIN_VISUALIZATION=true
SHOW_CELERY_TASKS=true

# immudb audit ledger (dev password must satisfy immudb's strength rules).
IMMUDB_ADMIN_PASSWORD=immudbDev1!

# Private Python package registry used to install plugins at runtime (optional).
PACKAGE_REGISTRY_URL=http://localhost:3141/
PACKAGE_REGISTRY_USER=
PACKAGE_REGISTRY_PASSWORD=
PACKAGE_REGISTRY_INDEX=root/public
