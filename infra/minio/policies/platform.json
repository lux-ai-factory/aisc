{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:*"],
      "Resource": ["arn:aws:s3:::proof-*", "arn:aws:s3:::proof-*/*"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::datasets", "arn:aws:s3:::artifacts", "arn:aws:s3:::models"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:DeleteObject"],
      "Resource": ["arn:aws:s3:::datasets/*", "arn:aws:s3:::artifacts/*", "arn:aws:s3:::models/*"]
    }
  ]
}
