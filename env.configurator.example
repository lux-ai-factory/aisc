# The Configurator's settings (docker-compose.configurator.yml). Copy this file to env.configurator, fill in the
# values marked "set", and run: uv run scripts/aisc.py start --configurator
#
# No secret is written here. Every line below that starts with "# NAME=" is a secret that scripts/aisc.py makes
# in env.secrets (git-ignored) and combines with this file into env.runtime, the file compose reads. Never put a
# value on one of those lines.

# --- this deployment ---------------------------------------------------------------------------------------------
# set: the build every aisc-* image runs (docker compose build tags them with it; a commit, such as sha-0123abc)
AISC_IMAGE_TAG=
# set: the host name of each part, served on 443 by Caddy (infra/caddy/Caddyfile.configurator) with one certificate
# for the four names: caddy-tls/server.crt and caddy-tls/server.key beside this file. Port 80 only redirects to
# https. Every address below is made from these names.
# the engine: the projects' pages
ENGINE_HOST=app.example.org
# the launcher: the start page
LAUNCHER_HOST=home.example.org
# the dashboard
DASHBOARD_HOST=dashboard.example.org
# the sign-in (Keycloak); its administration is not served on this name
SIGN_IN_HOST=auth.example.org
# The addresses the browser uses, from the names above, https only: start refuses one that is not
# https://<its name>. Every redirect and callback (the sign-in's, Keycloak's, the pages' links) is made from them.
CADDY_DOMAIN=https://${ENGINE_HOST}
API_URL_EXTERNAL=https://${ENGINE_HOST}
LAUNCHER_EXTERNAL_URL=https://${LAUNCHER_HOST}/
DASHBOARD_EXTERNAL_URL=https://${DASHBOARD_HOST}
KEYCLOAK_URL_EXTERNAL=https://${SIGN_IN_HOST}
# Caddy's development sites take no TLS of their own: the host-name sites in front of them have it (the
# Configurator's compose file sets this for Caddy whatever is written here)
CADDY_ENVIRONMENT=behind-the-host-sites
# Secure session cookie: the gateway is served over https
GATEWAY_COOKIE_SECURE=true
# Keycloak as the stack reaches it from inside (the JWKS fetch, not a browser)
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
# Only these origins may call the engine from a browser
BACKEND_CORS_ALLOWED_ORIGINS=https://${ENGINE_HOST}
CORS_ORIGINS=https://${ENGINE_HOST}
SHOW_PLUGIN_VISUALIZATION=true
# The ledger: docker-compose.configurator.yml sets LEDGER_MODE=enforce on every service that writes to it; the
# gateway's witness stays on
LEDGER_GATEWAY=on
# "Let AI suggest additions" on the AI card and "Suggest with AI" in Control objectives: on to offer them; off
# (the default) hides both buttons and their actions refuse
AISC_AI_ACTIONS=off

# --- plugins ------------------------------------------------------------------------------------------------------
PLUGIN_PATH=./local_plugins/
# the hosts every plugin test may reach besides the platform and its helpers (see env.plugin_downloader)
PLUGIN_EGRESS_ALLOWED_HOSTS=raw.githubusercontent.com
PACKAGE_REGISTRY_URL=http://devpi:3141
# empty: installs read the index without login
PACKAGE_REGISTRY_USER=
PACKAGE_REGISTRY_PASSWORD=
PACKAGE_REGISTRY_INDEX=root/public
DEVPI_INDEX=root/public
CATALOGUE_TRUSTED_INDEXES=http://devpi:3141/root/public/+simple/
CATALOGUE_EXTERNAL_URL=https://sandboxconfigurator.aifactory.lu/catalogue
CATALOGUE_API_URL=https://sandboxconfigurator.aifactory.lu/api/api
CATALOGUE_ORIGIN=https://sandboxconfigurator.aifactory.lu
# The engine checks TLS when it lists a provider's models
MODEL_LISTING_SSL_VERIFY=True

# --- object storage (MinIO) ---------------------------------------------------------------------------------------
S3_USER=aisc-s3-user
S3_DATASETS_BUCKET=datasets
S3_MODELS_BUCKET=models
S3_ARTIFACTS_BUCKET=artifacts
S3_URL=http://minio:9000

# --- queue and cache ----------------------------------------------------------------------------------------------
RABBITMQ_USERNAME=aisc-rabbit-user
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD comes from env.secrets, defined above this line in env.runtime
REDIS_BACKEND_URL=redis://:$REDIS_PASSWORD@$REDIS_HOST:$REDIS_PORT/0
API_URL=http://aisc-backend:8000
API_PREFIX=/api/v1/internal

# --- databases (TLS only: docker-compose.configurator.yml) --------------------------------------------------------
POSTGRES_USER=aisc-postgres-user
POSTGRES_DB=platform
POSTGRES_DB_HOST=postgres
POSTGRES_DB_PORT=5432
DB_NAME=platform
DB_USER=engine_rw
DB_SCHEMA=engine
DB_HOST=$POSTGRES_DB_HOST
DB_PORT=$POSTGRES_DB_PORT
DB_ENGINE=django.db.backends.postgresql

# --- the sign-in ---------------------------------------------------------------------------------------------------
KEYCLOAK_ADMIN=admin

