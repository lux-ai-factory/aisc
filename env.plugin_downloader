# No password or secret is written here: scripts/secrets.sh makes them in env.secrets, which git ignores,
# and combines both files into env.runtime, the file compose reads.

# To fetch the private plugin repos on install, set GITHUB_TOKEN in env.secrets (not here: this file is
# committed). Only plugin-publisher reads it.

PLUGIN_PATH=./local_plugins/
# Minio/S3 storage location config
#
S3_USER=aisc-s3-user
S3_PASSWORD=
S3_DATASETS_BUCKET=datasets
S3_MODELS_BUCKET=models
S3_ARTIFACTS_BUCKET=artifacts
S3_URL=http://minio:9000

# Backend config
API_URL_EXTERNAL="http://localhost"
CADDY_DOMAIN="http://localhost"
# true when CADDY_DOMAIN starts with https:// (the gateway's session cookie is then Secure); see docs/guide.md
GATEWAY_COOKIE_SECURE=false
CADDY_ENVIRONMENT="development"
SHOW_PLUGIN_VISUALIZATION=true

# Rabbitmq config
RABBITMQ_USERNAME=aisc-rabbit-user
RABBITMQ_PASSWORD=
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# DB configuration
POSTGRES_USER=aisc-postgres-user
POSTGRES_PASSWORD=
# The shared platform database: projects, their members and the libraries.
# Each project's module data lives in its own database, project_<pid without hyphens>.
POSTGRES_DB=platform
POSTGRES_DB_HOST=postgres
POSTGRES_DB_PORT=5432

# Redis configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Eval configuration
CELERY_BROKER_URL=amqp://$RABBITMQ_USERNAME:$RABBITMQ_PASSWORD@$RABBITMQ_HOST:$RABBITMQ_PORT//
REDIS_BACKEND_URL=redis://$REDIS_HOST:$REDIS_PORT/0
API_URL=http://aisc-backend:8000
API_PREFIX=/api/v1/internal
# INTERNAL_API_KEY comes from env.secrets, written by scripts/secrets.sh and never committed
# PLATFORM_SECRETS_KEY comes from env.secrets, written by scripts/secrets.sh and never committed
# PLATFORM_CARD_AGENT_TOKEN comes from env.secrets, written by scripts/secrets.sh and never committed
# PLATFORM_CONNECTIONS_TOKEN comes from env.secrets, written by scripts/secrets.sh and never committed
# PLATFORM_RISK_MAPPER_TOKEN comes from env.secrets, written by scripts/secrets.sh and never committed
# DASHBOARD_BRIDGE_TOKEN (the platform to the dashboard's bridge /api/v1/aisc_project) comes from env.secrets, written by scripts/secrets.sh and never committed
# Service tokens, one per caller edge; each is held by its caller and its callee only:
# QUALIFICATION_AGENTS_TO_WEB_TOKEN (the card agent to qualification-web /api/qualifications/{id}/extracted) comes from env.secrets, written by scripts/secrets.sh and never committed
# QUALIFICATION_WEB_TO_AGENTS_TOKEN (qualification-web to qualification-agents /fill) comes from env.secrets, written by scripts/secrets.sh and never committed
# QUALIFICATION_WEB_TO_ONTOLOGY_TOKEN (qualification-web to qualification-ontology) comes from env.secrets, written by scripts/secrets.sh and never committed
# QUALIFICATION_AGENTS_TO_ONTOLOGY_TOKEN (the card agent to qualification-ontology) comes from env.secrets, written by scripts/secrets.sh and never committed
# QUALIFICATION_WEB_TO_PREFILL_TOKEN (qualification-web to qualification-prefill) comes from env.secrets, written by scripts/secrets.sh and never committed
# QUALIFICATION_WEB_TO_PDF_TOKEN (qualification-web to qualification-pdf) comes from env.secrets, written by scripts/secrets.sh and never committed
# CONTROLS_WEB_TO_PDF_TOKEN (controls-web to controls-pdf) comes from env.secrets, written by scripts/secrets.sh and never committed
CORS_ORIGINS=*

# The execution engine's databases. DB_NAME=platform is where it reads who is in
# which project (core, never written), and the template its per-project
# connections are copied from: each project's `engine` schema is in
# project_<pid without hyphens>, with DB_SCHEMA on the search path. It connects
# as its own role.
DB_NAME=platform
DB_USER=engine_rw
# DB_PASSWORD: engine_rw's, generated by scripts/secrets.sh (ENGINE_RW_PASSWORD)
DB_SCHEMA=engine
DB_HOST=$POSTGRES_DB_HOST
DB_PORT=$POSTGRES_DB_PORT

# backend
# DJANGO_SECRET_KEY comes from env.secrets, written by scripts/secrets.sh and never committed
DB_ENGINE=django.db.backends.postgresql
BACKEND_CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"


# The engine installs from the stack's own devpi, which plugin-publisher fills, a plugin when an admin
# installs it, with the packages and versions the hosted catalogue names.
PACKAGE_REGISTRY_URL = http://devpi:3141
# empty: installs read the index without login (a user without a password stops the backend)
PACKAGE_REGISTRY_USER =
PACKAGE_REGISTRY_PASSWORD =
PACKAGE_REGISTRY_INDEX = root/public

# Provider keys, for the services that are given them in docker-compose.development.yml.
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Required by docker-compose-infra.development.yml and
# docker-compose.development.yml. Without them the documented one-command
# install comes up broken in two ways that are easy to miss:
#   * keycloak exits with "bootstrap-admin-username available only when
#     bootstrap admin password is set", while everything else looks healthy;
#   * the webapp substitutes APP_KEYCLOAK_URL into its JS bundle at container
#     start, so an empty value leaves it pointing at no identity provider and
#     the app never gets past auth init.
# ---------------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD: generated by scripts/secrets.sh (env.secrets), as are POSTGRES_PASSWORD,
# S3_PASSWORD and RABBITMQ_PASSWORD; env.runtime takes those four from env.secrets, not from here.
# Keycloak URL the BROWSER uses (injected into the built webapp via env.sh -> APP_KEYCLOAK_URL, and
# handed to the launcher's links through /origins.json). Keycloak publishes 8081 on 127.0.0.1 only.
KEYCLOAK_URL_EXTERNAL="http://localhost:8081"
# immudb's superuser password is not committed: scripts/secrets.sh makes it
# in env.secrets (IMMUDB_ADMIN_PASSWORD), and compose takes it from env.runtime.

# --- the gateway that makes one sign-in cover every module -------------------
# Both secrets are generated; Keycloak fills the aisc-gateway client's secret in
# keycloak/aisc-realm.json from GATEWAY_CLIENT_SECRET when the realm is imported.
# GATEWAY_CLIENT_SECRET comes from env.secrets, written by scripts/secrets.sh and never committed
# GATEWAY_COOKIE_SECRET comes from env.secrets, written by scripts/secrets.sh and never committed
# DASHBOARD_REDIS_PASSWORD (Superset's own cache, dashboard-redis) comes from env.secrets, written by scripts/secrets.sh and never committed

# --- catalogue and its one-click install (apps/catalogue) --------------------
# The index the engine installs from. Kept for reference: not enforced by the engine; PACKAGE_REGISTRY_URL decides where installs come from
CATALOGUE_TRUSTED_INDEXES=http://devpi:3141/root/public/+simple/
DEVPI_INDEX=root/public
# DEVPI_ROOT_PASSWORD: generated by scripts/secrets.sh (env.secrets)
# The catalogue is the hosted one; no catalogue runs in this stack. Where a browser opens it,
# where controls fetch a control's package (its API), and the only origin trusted to send installs.
CATALOGUE_EXTERNAL_URL=https://sandboxconfigurator.aifactory.lu/catalogue
CATALOGUE_API_URL=https://sandboxconfigurator.aifactory.lu/api/api
CATALOGUE_ORIGIN=https://sandboxconfigurator.aifactory.lu

# The launcher: the one page where a project is chosen.
LAUNCHER_EXTERNAL_URL=http://localhost:8100/

# Keycloak as the stack reaches it from inside (the JWKS fetch, not a browser).
KEYCLOAK_INTERNAL_URL=http://keycloak:8080

# The engine checks TLS when it lists a provider's models.
MODEL_LISTING_SSL_VERIFY=True
